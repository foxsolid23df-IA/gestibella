# === SUPABASE (requerido) ===
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
# Demo multi-tenant: slug del tenant por defecto
VITE_DEMO_TENANT_SLUG="gestibella-demo"

# === GEMINI (solo server, sin prefijo VITE) ===
# Usado por /api/gemini — no exponer al cliente
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# === APP ===
# En Vercel se inyecta automáticamente VERCEL_URL. Local:
VITE_APP_URL="http://localhost:3000"

# === LEGACY (AI Studio) ===
# APP_URL="MY_APP_URL"  # deprecated, usar VITE_APP_URL
