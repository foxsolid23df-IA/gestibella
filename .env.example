# ============================================================
# GestiBella - Variables de Entorno
# ============================================================
# Copia este archivo como .env.local y completa los valores.
# NUNCA commitees .env.local al repositorio.
# ============================================================

# ------------------------------------------------------------
# Supabase (obtener desde Dashboard > Settings > API)
# ------------------------------------------------------------
# URL del proyecto Supabase
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"

# Clave anónima (segura para usar en el navegador, expuesta al cliente)
VITE_SUPABASE_ANON_KEY="sb_publishable_tu_clave_aqui"

# Clave service_role (SOLO server-side, NUNCA usar VITE_ prefix)
# Si esta clave se expone al cliente, cualquier usuario podría
# bypassear RLS y acceder a toda la base de datos.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_tu_clave_service_role"

# Clave anónima para server-side (opcional, misma que VITE_SUPABASE_ANON_KEY)
SUPABASE_ANON_KEY="sb_publishable_tu_clave_aqui"

# ------------------------------------------------------------
# Tenant Demo
# ------------------------------------------------------------
# Slug del tenant que se usa en modo demo (login sin auth real)
VITE_DEMO_TENANT_SLUG="gestibella-demo"

# ------------------------------------------------------------
# App URL (para redirecciones y CORS)
# ------------------------------------------------------------
VITE_APP_URL="https://tu-dominio.vercel.app"

# ------------------------------------------------------------
# Super Admin (para ruta /admin)
# ------------------------------------------------------------
# Email del super-administrador. Solo este email puede acceder
# a la ruta /admin y gestionar tenants/platform_admins.
VITE_SUPER_ADMIN_EMAIL="admin@tudominio.com"

# ------------------------------------------------------------
# Gemini API (server-side only)
# ------------------------------------------------------------
# Clave API de Google Gemini para el chatbot de asesoría.
# NUNCA usar VITE_ prefix - solo accesible server-side en api/gemini.ts
GEMINI_API_KEY="tu_clave_gemini_aqui"

# ============================================================
# NOTAS DE SEGURIDAD
# ============================================================
# 1. .env.local NO debe ser commiteado (ya está en .gitignore)
# 2. Las claves con prefijo VITE_ son expuestas al navegador
#    - Solo usar para: URL, anon key, tenant slug, app URL, admin email
# 3. Las claves sin prefijo VITE_ son solo server-side
#    - Usar para: service_role key, gemini API key
# 4. En Vercel: configurar estas variables en Settings > Environment Variables
#    - NO usar .env.local en producción (Vercel lee de su propio vault)
# 5. Si el repo fue compartido o tiene historial público,
#    rotar todas las claves inmediatamente
# ============================================================
